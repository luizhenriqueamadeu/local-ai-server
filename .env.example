# Local AI Server Configuration
#
# HOW PROVIDERS WORK
# A provider is ONLY registered (and enters the "auto" rotation) when its
# API key below is filled. Commented / empty = disabled. No code edits needed.

# =========== SERVER ===========
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# =========== OPENROUTER =========== (https://openrouter.ai/keys)
# ~100+ models incl. many free ":free" models - the main rotation source
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=Local AI Server

# =========== NVIDIA NIM =========== (https://build.nvidia.com/)
# Free Nemotron / Llama / Mistral models
NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------- FILL A KEY TO ACTIVATE THAT PROVIDER ----------

# Groq - ultra fast Llama, generous free tier (https://console.groq.com/keys)
#GROQ_API_KEY=
#GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini - free tier via OpenAI-compatible endpoint (https://aistudio.google.com/app/apikey)
#GEMINI_API_KEY=
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Cerebras - extremely fast, free tier (https://cloud.cerebras.ai/)
#CEREBRAS_API_KEY=
#CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Mistral - free experimental tier (https://console.mistral.ai/api-keys)
#MISTRAL_API_KEY=
#MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Together AI - some models at $0.00 (https://api.together.ai/settings/api-keys)
#TOGETHER_API_KEY=
#TOGETHER_BASE_URL=https://api.together.xyz/v1

# HuggingFace router - free/cheap inference (https://huggingface.co/settings/tokens)
#HUGGINGFACE_API_KEY=
#HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# DeepSeek - cheap (not free) (https://platform.deepseek.com/api_keys)
#DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI - paid, acts as paid last resort (https://platform.openai.com/api-keys)
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama / LM Studio - LOCAL models, no key needed!
# To activate: set OLLAMA_MODELS with your installed models (comma separated)
#OLLAMA_BASE_URL=http://localhost:11434/v1
#OLLAMA_MODELS=llama3.1:8b,qwen2.5:7b

# LM Studio (local)
#LMSTUDIO_BASE_URL=http://localhost:1234/v1
#LMSTUDIO_MODELS=your-model-id

# =========== YOUR OWN SERVER / ANY OPENAI-COMPATIBLE API ===========
# Point to ANY endpoint that speaks the OpenAI protocol
# (your own service, vLLM, LiteLLM, another local-ai-server instance...)
#CUSTOM_AI_NAME=My Own AI
#CUSTOM_AI_BASE_URL=http://192.168.2.20:8000/v1
#CUSTOM_AI_API_KEY=
#CUSTOM_AI_MODELS=my-model-1,my-model-2
#CUSTOM_AI_CONTEXT_LENGTH=8192
#CUSTOM_AI_MAX_TOKENS=4096

# =========== MODEL ROTATION STRATEGY ===========
# Options: rate-limit, round-robin, priority
ROTATION_STRATEGY=rate-limit

# Free models to prioritize (comma-separated, order = preference)
FREE_MODELS_PRIORITY=meta-llama/llama-3.1-8b-instruct:free,google/gemma-2-9b-it:free,mistralai/mistral-7b-instruct:free,nvidia/nemotron-3-ultra

# Context preservation when switching models
PRESERVE_CONTEXT=true
MAX_CONTEXT_MESSAGES=20

# Rate limit handling
RATE_LIMIT_RETRY_DELAY=5000
MAX_RETRIES=3

# Request timeout (ms)
REQUEST_TIMEOUT=120000

# ---- Circuit breaker (pulsa modelos ruins automaticamente) ----
# N de falhas consecutivas para abrir o circuito do modelo
CIRCUIT_THRESHOLD=3
# Tempo de cooldown com o circuito aberto (ms). Depois volta a testar (half-open)
CIRCUIT_COOLDOWN_MS=300000

# ---- Cache de respostas idênticas (hit instantaneo) ----
ENABLE_CACHE=true
CACHE_TTL_SECONDS=60
CACHE_MAX=200

# Allow changing provider keys from OTHER network PCs via the web settings UI
# (default: only localhost can access /v1/config - safer)
#ALLOW_REMOTE_CONFIG=true
